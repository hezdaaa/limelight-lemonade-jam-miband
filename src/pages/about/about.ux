        <text class="acknowledge-btn" if="{{isFirstVisit}}"  onclick="acknowledge">我已知晓</text>
      <text class="title"></text> 
      </scroll>
      
      <!-- 左上角返回按钮：仅非初次访问时显示 -->
      <img class="back-btn" src="/common/back.png" onclick="back" if="{{!isFirstVisit}}"></img> 
    </div> 
  </template> 
  
  <script> 
  import router from '@system.router'
  import storage from '@system.storage'
  
  export default { 
    data: { 
      build: false,
      isFirstVisit: true    // 默认为初次访问，待读取存储后更新
    }, 
    
    onInit() {
      // 读取是否已访问过 about 页面
      storage.get({
        key: 'about_visited',
        success: (data) => {
          if (data === 'true') {
            this.isFirstVisit = false;  
          } else {
            this.isFirstVisit = true; 
          }
        },
        fail: () => {
          // 读取失败（键不存在），视为初次访问
          this.isFirstVisit = true;
        }
      });
    },
    
    back() { 
      router.back({ 
        uri: 'pages/index'
      }) 
    },
    
    acknowledge() {
      // 标记已访问
      storage.set({
        key: 'about_visited',
        value: 'true',
        success: () => {
          this.back();   // 返回主页
        },
        fail: () => {
          this.back();   // 即使存储失败也返回
        }
      });
    }
  }; 
  </script> 
  
