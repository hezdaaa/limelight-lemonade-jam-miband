<template> 
    <div class="page"> 
        <img class="bcg" src="/common/bcgi/空_夕_夏.jpg"></img> 
        <img class="bt" src="/common/bt.png"></img> 
        <img class="hd" src="/common/hd.png"></img> 
        
        <scroll id="mainScroll" class="scroll" scroll-y="{{true}}" if="{{!showAS}}">
            <div class="header">
                <text class="title">更多</text> 
            </div>
            <div class="content" onclick="lctruote">
                <text class="mid">流程图</text>
            </div>
            <div class="content" onclick="cgruote">
                <text class="mid">鉴赏模式</text>
            </div>
            <div class="content" onclick="afterstoryshow">
                <text class="mid">后日谈</text>
            </div>
        </scroll>
        
        <div class="page1" if="{{showAS}}">
            <img class="bcg" src="/common/bcgi/空_夕_夏.jpg"></img> 
            <img class="bt" src="/common/bt.png"></img> 
            <img class="hd" src="/common/hd.png"></img> 
            <!-- 惠凪后日谈 -->
            <div class="page2" if="{{character==1}}">
                <image class="cig" src="/common/cimg/hz02_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">惠凪</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(24546)">开始</text>
                </div>
            </div>
            
            <!-- 杏珠后日谈 -->
            <div class="page2" if="{{character==2}}">
                <image class="cig" src="/common/cimg/xz05_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">杏珠</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(54247)">开始</text>
                </div>
            </div>
            
            <!-- 月望后日谈 -->
            <div class="page2" if="{{character==3}}">
                <image class="cig" src="/common/cimg/yw02_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">月望</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(67285)">开始</text>
                </div>
            </div>
            
            <!-- 莉莉子后日谈 -->
            <div class="page2" if="{{character==4}}">
                <image class="cig" src="/common/cimg/llz01_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">莉莉子</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(34397)">开始</text>
                </div>
            </div>
            
            <!-- 美玖后日谈 -->
            <div class="page2" if="{{character==5}}">
                <image class="cig" src="/common/cimg/mj01_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">美玖</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(45171)">开始</text>
                </div>
            </div>
            
            <!-- 那优花后日谈 -->
            <div class="page2" if="{{character==6}}">
                <image class="cig" src="/common/cimg/nyh01_1.png"></image>
                <div class="header">
                    <text class="title">后日谈</text> 
                </div>
                <text class="mid1">那优花</text>
                <div class="startBtn">
                    <text class="startText" onclick="loadStart(39924)">开始</text>
                </div>
            </div>
            
            <!-- 导航按钮 -->
            <img class="last-btn" src="/common/back.png" onclick="last"></img> 
            <img class="enter-btn" src="/common/go.png" onclick="enter"></img> 
        </div>
        
        <!-- 返回按钮 -->
        <img class="back-btn" src="/common/back.png" onclick="back"></img> 
    </div> 
</template> 

<script> 
import storage from '@system.storage'
import router from '@system.router' 

export default { 
    data: { 
        showAS: false, 
        character: 1,
    }, 
    
    // 上一个角色
    last() { 
        if (this.character > 1) {
            this.character -= 1;
        } else if (this.character == 1) {
            this.character = 6;
        }
    },
    
    // 下一个角色
    enter() { 
        if (this.character < 6) {
            this.character += 1;
        } else if (this.character == 6) {
            this.character = 1;
        }
    },
    
    // 返回逻辑
    back() { 
        if (!this.showAS) {
            router.back({ 
                uri: 'pages/index', 
            });
        } else {
            this.showAS = false;
        }
    }, 
    
    // 跳转到流程图页面
    lctruote() {
        router.push({
            uri: 'pages/lct',
        });
    },
    
    // 跳转到CG鉴赏页面
    cgruote() {
        router.push({
            uri: 'pages/cgs',
        });
    },
    
    // 显示后日谈选择界面
    afterstoryshow() {
        this.showAS = true;
    },
    
    // 开始后日谈（需要实现具体逻辑）

    loadStart(a){
    storage.set({
      key: 'readProgress',
      value: JSON.stringify(a),
      success: () => console.log('进度设置成功'),
      fail: (error) => console.error('进度设置失败:', error)
    });
    router.replace({
      uri:'pages/detail'
    })
  },
}; 
</script> 

