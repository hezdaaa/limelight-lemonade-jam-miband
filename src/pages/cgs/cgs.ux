    left: 0;
    object-fit: contain;
    background-color: #000000;
    z-index: 1;
}

.character {
    position: absolute;
    top: 50px;
    left: 100px;
    z-index: 3;
    transform: scale(0.5);
}

.backgroundimg {
    position: absolute;
    width: 336px;
    height:480px;
    top: 0;
    left: 0;
    object-fit: cover;
    z-index: 2;
}

.info-text {
    font-size: 16px;
