</template> 

<script> 
import storage from '@system.storage'
import router from '@system.router' 

export default { 
    data:{ 
        page:1,
    }, 
    loadStart(a){
    storage.set({
      key: 'readProgress',
      value: JSON.stringify(a),
      success: () => console.log('进度设置成功'),
      fail: (error) => console.error('进度设置失败:', error)
    });
    router.push({
      uri:'pages/detail'
    })
  },
    back(){ 
        console.log("返回");
        router.back({
            uri:'pages/more',
        }) 
    }, 
    last() { 
        if (this.page > 1) {
            this.page -= 1;
        } else if (this.page == 1) {
            this.page = 7;
        }
    },
    
    // 下一个角色
    enter() { 
        if (this.page < 7) {
            this.page += 1;
        } else if (this.page == 7) {
            this.page = 1;
        }
    },
}; 
</script> 

